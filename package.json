{
  "name": "@openasy/sast",
  "version": "0.4.0",
  "private": true,
  "description": "OpenAsy SAST: static analysis findings from every pull request, with only what is new blocking it.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openasy/sast.git"
  },
  "scripts": {
    "dev": "vite --config web/vite.config.ts",
    "start": "node server/main.ts",
    "build": "vite build --config web/vite.config.ts && node scripts/build-docs.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run"
  },
  "prettier": "@openasy/code-style/prettier",
  "devDependencies": {
    "@openasy/code-style": "https://github.com/openasy/code-style/releases/download/v0.1.2/openasy-code-style-0.1.2.tgz",
    "@openasy/ui": "https://github.com/openasy/ui/releases/download/v0.8.0/openasy-ui-0.8.0.tgz",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "ajv": "^8.20.0",
    "lucide-react": "^1.59.0",
    "oxlint": "1.87.0",
    "prettier": "3.9.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "swagger-ui-dist": "^5.34.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=26.12.0",
    "npm": ">=11"
  },
  "dependencies": {
    "@openasy/auth": "https://github.com/openasy/auth/releases/download/v0.9.0/openasy-auth-0.9.0.tgz"
  }
}
