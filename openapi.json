            "description": "The database is unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "operationId": "metrics",
        "tags": [
          "Product"
        ],
        "summary": "Prometheus metrics",
        "security": [],
        "responses": {
          "200": {
            "description": "Metrics in the Prometheus text format.",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-openasy-session",
        "description": "The browser session after signing in (`openasy-session` when sast runs on plain http://localhost). Requests that change something must come from the sast origin."
      },
      "apiToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "An API token created under Settings \u2192 API tokens (`oa_sast_...`): one role, always an expiry (ADR 0003)."
      },
      "adminToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "Only when sast is started by its tests or a local script: one shared token with the admin role. A production install does not have it."
      },
      "ingestToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "`SAST_INGEST_TOKEN`: for CI. It can send scans, nothing else."
      }
    },
    "responses": {
      "Problem": {
        "description": "An error, as RFC 9457 Problem Details.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      }
    },
    "schemas": {
      "Problem": {
        "type": "object",
        "required": [
          "type",
          "title",
          "status",
          "code"
        ],
        "properties": {
          "type": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "code": {
            "type": "string",
            "enum": [
              "invalid-token",
              "invalid-json",
              "invalid-body",
              "invalid-sarif",
              "not-found",
              "not-configured",
              "payload-too-large",
              "internal-error",
              "unauthenticated",
              "invalid-credentials",
              "mfa-required",
              "mfa-setup-required",
              "forbidden",
              "cross-site",
              "rate-limited"
            ],
            "description": "Stable; match on this."
          },
          "detail": {
            "type": "string"
          }
        }
      },
      "Severity": {
        "type": "string",
        "enum": [
          "critical",
          "high",
          "medium",
          "low"
        ]
      },
      "FailOn": {
        "type": "string",
        "enum": [
          "critical",
          "high",
          "medium",
          "low",
          "none"
        ],
        "description": "The lowest severity of a new finding that fails the check; `none` never fails it."
      },
      "Counts": {
        "type": "object",
        "required": [
          "critical",
          "high",
          "medium",
          "low"
        ],
        "additionalProperties": false,
        "properties": {
          "critical": {
            "type": "integer"
          },
          "high": {
            "type": "integer"
          },
          "medium": {
            "type": "integer"
          },
          "low": {
            "type": "integer"
          }
        }
      },
      "Version": {
        "type": "object",
        "required": [
          "product",
          "version"
        ],
        "properties": {
          "product": {
            "const": "sast"
          },
          "version": {
            "type": "string"
          }
        }
      },
      "ProductLink": {
        "type": "object",
        "required": [
          "id",
          "url"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "The product, as OpenAsy names it.",
            "examples": [
              "infrastructure"
            ]
          },
          "url": {
            "type": "string",
            "format": "uri",
            "description": "The address people open it at.",
            "examples": [
              "https://infra.example.com"
            ]
          }
        }
      },
      "ProductList": {
        "type": "object",
        "required": [
          "products"
        ],
        "properties": {
          "products": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProductLink"
            }
          }
        }
      },
      "Status": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string"
          }
        }
      },
      "Summary": {
        "type": "object",
        "required": [
          "repositories",
          "open",
          "suppressed",
          "failingChecks",
          "lastScanAt"
        ],
        "additionalProperties": false,
        "properties": {
          "repositories": {
            "type": "integer"
          },
          "open": {
            "$ref": "#/components/schemas/Counts"
          },
          "suppressed": {
            "type": "integer",
            "description": "Open findings someone marked as a false positive or accepted risk."
          },
          "failingChecks": {
            "type": "integer",
            "description": "Scans of the last 7 days that failed their check."
          },
          "lastScanAt": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "format": "date-time"
              }
            ]
          }
        }
      },
      "Repository": {
        "type": "object",
        "required": [
          "id",
          "name",
          "defaultBranch",
          "failOn",
          "open",
          "suppressed",
          "lastScan",
          "createdAt"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "defaultBranch": {
            "type": "string"
          },
          "failOn": {
            "$ref": "#/components/schemas/FailOn"
          },
          "open": {
            "$ref": "#/components/schemas/Counts"
          },
          "suppressed": {
            "type": "integer"
          },
          "lastScan": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "required": [
                  "at",
                  "kind",
                  "branch",
                  "new",
                  "passed"
                ],
                "additionalProperties": false,
                "properties": {
                  "at": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "baseline",
                      "change"
                    ]
                  },
                  "branch": {
                    "type": "string"
                  },
                  "new": {
                    "type": "integer"
                  },
                  "passed": {
                    "type": "boolean"
                  }
                }
              }
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "RepositoryList": {
        "type": "object",
        "required": [
          "repositories"
        ],
        "properties": {
          "repositories": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Repository"
            }
          },
          "nextCursor": {
            "type": "string",
            "description": "Pass the previous page's nextCursor to get the next page."
          }
        }
      },
      "UpdateRepository": {
        "type": "object",
        "additionalProperties": false,
        "minProperties": 1,
        "properties": {
          "defaultBranch": {
            "type": "string"
          },
          "failOn": {
            "$ref": "#/components/schemas/FailOn"
          }
        }
      },
      "TriageState": {
        "type": "object",
        "required": [
          "state",
          "reason",
          "by",
          "at",
          "expiresAt",
          "active"
        ],
        "additionalProperties": false,
        "properties": {
          "state": {
            "type": "string",
            "enum": [
              "false-positive",
              "accepted"
            ]
          },
          "reason": {
            "type": "string"
          },
          "by": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string"
              }
            ]
          },
          "at": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "format": "date-time"
              }
            ]
          },
          "expiresAt": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "format": "date-time"
              }
            ]
          },
          "active": {
            "type": "boolean",
            "description": "False once the acceptance has expired; the finding is open again."
          }
        }
      },
      "Finding": {
        "type": "object",
        "required": [
          "repository",
          "fingerprint",
          "rule",
          "severity",
          "path",
          "line",
          "message",
          "snippet",
          "firstSeen",
          "lastSeen",
          "resolvedAt",
          "triage"
        ],
        "additionalProperties": false,
        "properties": {
          "repository": {
            "type": "object",
            "required": [
              "id",
              "name"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              }
            }
          },
          "fingerprint": {
            "type": "string",
            "description": "Stable across moved lines and other branches."
          },
          "rule": {
            "type": "string"
          },
          "severity": {
            "$ref": "#/components/schemas/Severity"
          },
          "path": {
            "type": "string"
          },
          "line": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "integer"
              }
            ]
          },
          "message": {
            "type": "string"
          },
          "snippet": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string"
              }
            ]
          },
          "firstSeen": {
            "type": "string",
            "format": "date-time"
          },
          "lastSeen": {
            "type": "string",
            "format": "date-time"
          },
          "resolvedAt": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "format": "date-time"
              }
            ]
          },
          "triage": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/TriageState"
              }
            ]
          }
        }
      },
      "FindingList": {
        "type": "object",
        "required": [
          "findings"
        ],
        "properties": {
          "findings": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Finding"
            }
          },
          "nextCursor": {
            "type": "string",
            "description": "Pass the previous page's nextCursor to get the next page."
          }
        }
      },
      "NewTriage": {
        "type": "object",
        "required": [
          "state"
        ],
        "additionalProperties": false,
        "properties": {
          "state": {
            "type": "string",
            "enum": [
              "open",
              "false-positive",
              "accepted"
            ],
            "description": "`open` clears an earlier decision."
          },
          "reason": {
            "type": "string",
            "minLength": 3,
            "maxLength": 500,
            "description": "Required for false-positive and accepted."
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "description": "Required for accepted, at most 366 days away; optional for a false positive."
          }
        }
      },
      "Scan": {
        "type": "object",
        "required": [
          "id",
          "repository",
          "kind",
          "branch",
          "commit",
          "pullRequest",
          "tool",
          "total",
          "new",
          "suppressed",
          "blocking",
          "failOn",
          "passed",
          "createdAt"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "repository": {
            "type": "object",
            "required": [
              "id",
              "name"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              }
            }
          },
          "kind": {
            "type": "string",
            "enum": [
              "baseline",
              "change"
            ],
            "description": "`baseline` for the default branch, `change` for any other branch or a pull request."
          },
          "branch": {
            "type": "string"
          },
          "commit": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string"
              }
            ]
          },
          "pullRequest": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string"
              }
            ]
          },
          "tool": {
            "type": "string"
          },
          "total": {
            "type": "integer",
            "description": "Everything the tool reported."
          },
          "new": {
            "type": "integer",
            "description": "Findings the baseline does not have and nobody has triaged."
          },
          "suppressed": {
            "type": "integer",
            "description": "New findings someone had triaged."
          },
          "blocking": {
            "type": "integer",
            "description": "New findings at or above failOn. Always 0 for a scan of the default branch, which adopts what is there."
          },
          "failOn": {
            "$ref": "#/components/schemas/FailOn"
          },
          "passed": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "NewScan": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Scan"
          },
          {
            "type": "object",
            "required": [
              "findings"
            ],
            "properties": {
              "findings": {
                "type": "array",
                "maxItems": 100,
                "description": "The new findings, most severe first, up to 100.",
                "items": {
                  "type": "object",
                  "required": [
                    "fingerprint",
                    "rule",
                    "severity",
                    "path",
                    "line",
                    "message"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "fingerprint": {
                      "type": "string"
                    },
                    "rule": {
                      "type": "string"
                    },
                    "severity": {
                      "$ref": "#/components/schemas/Severity"
                    },
                    "path": {
                      "type": "string"
                    },
                    "line": {
                      "oneOf": [
                        {
                          "type": "null"
                        },
                        {
                          "type": "integer"
                        }
                      ]
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        ]
      },
      "ScanDetail": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Scan"
          },
          {
            "type": "object",
            "required": [
              "findings"
            ],
            "properties": {
              "findings": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "fingerprint",
                    "rule",
                    "severity",
                    "path",
                    "line",
                    "message",
                    "snippet",
                    "suppressed"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "fingerprint": {
                      "type": "string"
                    },
                    "rule": {
                      "type": "string"
                    },
                    "severity": {
                      "$ref": "#/components/schemas/Severity"
                    },
                    "path": {
                      "type": "string"
                    },
                    "line": {
                      "oneOf": [
                        {
                          "type": "null"
                        },
                        {
                          "type": "integer"
                        }
                      ]
                    },
                    "message": {
                      "type": "string"
                    },
                    "snippet": {
                      "oneOf": [
                        {
                          "type": "null"
                        },
                        {
                          "type": "string"
                        }
                      ]
                    },
                    "suppressed": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          }
        ]
      },
      "ScanList": {
        "type": "object",
        "required": [
          "scans"
        ],
        "properties": {
          "scans": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Scan"
            }
          },
          "nextCursor": {
            "type": "string",
            "description": "Pass the previous page's nextCursor to get the next page."
          }
        }
      }
    }
  }
}
