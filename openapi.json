{
  "openapi": "3.1.1",
  "info": {
    "title": "OpenAsy SAST API",
    "version": "0.4.0",
    "summary": "Static analysis findings from every pull request; only what is new blocks it.",
    "description": "Every screen of sast uses this API, and so can your scripts and CI (ADR 0014). Within `/api/v1` changes are additive only; anything removed is deprecated first (ADR 0024). Errors use Problem Details (RFC 9457).\n\nSend SARIF 2.1.0 from any analyser with `SAST_INGEST_TOKEN`. Everything else takes the session of a signed-in person or an API token, and each operation names the role it needs (`x-openasy-role`: viewer, editor, admin; ADR 0003).\n\nSign-in, members and API tokens are under `/api/v1/auth`, provided by [@openasy/auth](https://github.com/openasy/auth#routes).",
    "license": {
      "name": "AGPL-3.0-only",
      "identifier": "AGPL-3.0-only"
    }
  },
  "servers": [
    {
      "url": "/",
      "description": "This sast"
    }
  ],
  "tags": [
    {
      "name": "Scans",
      "description": "SARIF from CI, compared with the default branch."
    },
    {
      "name": "Repositories",
      "description": "What is scanned, its baseline branch and when a check fails."
    },
    {
      "name": "Findings",
      "description": "What the analysers found, and the decisions about it."
    },
    {
      "name": "Product",
      "description": "Version and overview of this sast."
    }
  ],
  "paths": {
    "/api/v1/scans": {
      "post": {
        "operationId": "sendScan",
        "tags": [
          "Scans"
        ],
        "summary": "Send a scan",
        "security": [
          {
            "ingestToken": []
          },
          {
            "session": []
          },
          {
            "apiToken": []
          },
          {
            "adminToken": []
          }
        ],
        "description": "Takes a SARIF 2.1.0 log from any analyser, such as Opengrep, Semgrep or CodeQL, and compares it with the default branch. Scans of the default branch become the baseline; every other scan reports only the findings the baseline does not have and nobody has triaged, and `blocking` counts those at or above the repository's `failOn`. The repository is created by its first scan.\n\n```bash\nopengrep scan --sarif-output=results.sarif .\ncurl -sf -X POST -H \"Authorization: Bearer $SAST_INGEST_TOKEN\" -H 'content-type: application/json' --data-binary @results.sarif \\\n  \"https://sast.example.com/api/v1/scans?repository=acme/web&branch=$BRANCH&commit=$SHA&pullRequest=$PR\" | tee scan.json\ntest \"$(jq .passed scan.json)\" = true\n```\n\nThe body may be gzipped (`Content-Encoding: gzip`), up to 64 MiB unpacked, with at most 50,000 results.\n\nTakes SAST_INGEST_TOKEN, or an API token with the editor role.",
        "parameters": [
          {
            "name": "repository",
            "in": "query",
            "required": true,
            "description": "Name such as `acme/web`.",
            "schema": {
              "type": "string",
              "maxLength": 128
            }
          },
          {
            "name": "branch",
            "in": "query",
            "required": true,
            "description": "The branch that was scanned.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "commit",
            "in": "query",
            "required": false,
            "description": "The commit hash.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "pullRequest",
            "in": "query",
            "required": false,
            "description": "The pull request number or name. A scan of the default branch with a pull request is still compared, not made the baseline.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "defaultBranch",
            "in": "query",
            "required": false,
            "description": "Set when the repository is new or the default branch changed. Without it a new repository uses `main`.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "description": "A SARIF 2.1.0 log."
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Compared with the baseline. `passed` says whether the check passes.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NewScan"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Problem"
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          },
          "403": {
            "$ref": "#/components/responses/Problem"
          },
          "413": {
            "$ref": "#/components/responses/Problem"
          },
          "422": {
            "$ref": "#/components/responses/Problem"
          },
          "503": {
            "$ref": "#/components/responses/Problem"
          }
        },
        "x-openasy-role": "editor"
      }
    },
