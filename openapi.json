          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "The repository's id.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "fingerprint",
            "in": "path",
            "required": true,
            "description": "From a finding or a scan.",
            "schema": {
